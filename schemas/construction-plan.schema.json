{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lego-modellbyggaren/schemas/construction-plan.schema.json",
  "title": "LEGO Modellbyggaren construction plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_goal", "interpreted_requirements", "assumptions", "target_envelope_studs", "sections", "assembly_order", "fallback_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "design_goal": {"type": "string", "minLength": 1},
    "interpreted_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detail_level"],
      "properties": {
        "detail_level": {"enum": ["simple", "balanced", "detailed"]},
        "max_parts": {"type": ["integer", "null"], "minimum": 1},
        "preferred_colors": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_envelope_studs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "depth": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "technique", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "purpose": {"type": "string", "minLength": 1},
          "technique": {"enum": ["studs_up", "orthogonal_rotated", "layered_plate", "mixed_conservative"]},
          "priority": {"enum": ["structural", "recognition", "detail"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "assembly_order": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "fallback_policy": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["replace_verified_part", "change_dimensions", "simplify_section", "remove_noncritical_detail", "reduce_detail_level", "report_unverifiable"]}
    }
  }
}
