{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lego-modellbyggaren/schemas/model.schema.json",
  "title": "LEGO Modellbyggaren internal model",
  "description": "Canonical structured intermediate representation used before LDraw serialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "requirements",
    "dimensions",
    "submodels",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "dimensions": {
      "$ref": "#/$defs/dimensions"
    },
    "submodels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/submodel"
      }
    },
    "validation": {
      "$ref": "#/$defs/modelValidation"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "name",
        "description",
        "status"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "validating",
            "validated",
            "failed"
          ]
        },
        "author_note": {
          "type": "string"
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_prompt",
        "design_intent"
      ],
      "properties": {
        "source_prompt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "design_intent": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "max_parts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "preferred_colors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "target_dimensions_studs": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "width",
            "depth",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "detail_level": {
          "enum": [
            "simple",
            "balanced",
            "detailed"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "min",
        "max"
      ],
      "properties": {
        "unit": {
          "const": "LDU"
        },
        "min": {
          "$ref": "#/$defs/vector3"
        },
        "max": {
          "$ref": "#/$defs/vector3"
        }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "rotationMatrix": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number"
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/rotationMatrix"
        }
      }
    },
    "partValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_reference",
        "placement"
      ],
      "properties": {
        "catalog_reference": {
          "enum": [
            "unverified",
            "verified",
            "failed"
          ]
        },
        "placement": {
          "enum": [
            "unchecked",
            "valid",
            "failed"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "ldraw_part",
        "color",
        "placement",
        "validation"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "ldraw_part": {
          "type": "string",
          "description": "LDraw part filename. Existence is verified against the authoritative catalog in development step 3.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]*\\.dat$"
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "description": "Numeric LDraw color code. Historical LEGO part/color availability is outside version 1 schema validation."
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "validation": {
          "$ref": "#/$defs/partValidation"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "submodel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "submodel_instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/submodelInstance"
          }
        }
      }
    },
    "modelValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "catalog",
        "geometry"
      ],
      "properties": {
        "schema": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "catalog": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "geometry": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "submodelInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "submodel_id",
        "placement"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "submodel_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "default": 16
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
